\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 Grabbing the manuscript pages while fleeing\cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 You clutch the pages to your chest. The wind tears at them but you hold fast. 
\f2\fs26 has_manuscript +1
\f1\fs24 \cell 
