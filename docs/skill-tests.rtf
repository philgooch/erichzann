\f1\b0 \cf0 1.3 Blandot's House\cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 Negotiating for a room\cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 The fifth floor is available \'97 directly below Zann. Close enough to hear, close enough to reach. 
\f2\fs26 dread +1
\f1\fs24  (foreshadowing)\cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
